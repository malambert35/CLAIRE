# Linux defaults; on Unraid replace ./data with /mnt/user/appdata/claire.
CLAIRE_DATA_PATH=./data/archive
CLAIRE_DB_PATH=./data/postgres
CLAIRE_MODELS_PATH=./data/models
CLAIRE_SECRET_PATH=./data/secrets
CLAIRE_PORT=8000
CLAIRE_ORIGIN=https://claire.example.test
CLAIRE_SECURE_COOKIES=true
PUID=10001
PGID=10001
# Ollama local chat. For Windows native mode use http://127.0.0.1:11434.
CLAIRE_LLM_BASE_URL=http://claire-ollama:11434
CLAIRE_LLM_MODEL=qwen3:8b
# Remote providers, MCP and voice are not enabled.
